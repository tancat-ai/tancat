# Dockerfile for the Phase 7 CI/CD GitHub Action image.
#
# The action image is now the PRODUCT image plus an entrypoint. The environment,
# the Playwright browsers and uid/gid 1000 are inherited, so the app and the
# action share one copy of the environment instead of carrying two (the pair was
# 44.6GB on 2026-09-30). The action only adds /entrypoint.sh and runs as uid/gid
# 1001, because the GitHub runner owns the mounted workspace as 1001.
#
# BUILD ORDER MATTERS - the product image must exist first:
#     docker build -t tancat-product:latest -f Dockerfile .
#     docker build --build-arg PRODUCT_IMAGE=tancat-product:latest \
#         -f Dockerfile.action -t tancat-action .
#
# KEPT AT THE REPO ROOT on purpose: the build context must be the repository
# root so `COPY action/entrypoint.sh` resolves.
#
# NOTE for the GitHub action: `action.yml` uses `image: 'Dockerfile.action'`, so
# GitHub builds this file itself on a clean runner and would not find the local
# `tancat-product` image. Before the action is used from GitHub, the product
# image must be published to a registry and PRODUCT_IMAGE pointed at it (or
# action.yml switched to a published image reference).

ARG PRODUCT_IMAGE=tancat-product:latest
FROM ${PRODUCT_IMAGE} AS runtime

WORKDIR /app

# The inherited environment is owned by uid 1000 (appuser) and is world-readable,
# so the action needs no chown pass and no second copy of the environment. The
# action runs as uid 1001 so the mounted GitHub workspace (owned by the runner,
# 1001) stays writable.
COPY action/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && groupadd --gid 1001 actionuser \
    && useradd --create-home --uid 1001 --gid 1001 --shell /bin/bash actionuser
ENV HOME=/home/actionuser
USER actionuser

# Clear the inherited CMD (the product's Streamlit command); the entrypoint reads
# its inputs from the environment.
CMD []

ENTRYPOINT ["/entrypoint.sh"]
