{
  "id": "eval-010",
  "site": "ambiguous_mock",
  "base_url": "http://localhost:8781/index.html",
  "mock_dir": "mock_sites/ambiguous",
  "title": "Place an order and verify the success message",
  "user_story": "As a customer, I want to pick an item, place my order, and see confirmation that the order was placed successfully.",
  "conditions": [
    "1. Navigate to the store home page",
    "2. Select an item and set a quantity in the order form",
    "3. Click the Place Order button",
    "4. Verify the order success message appears on the confirmation page"
  ],
  "golden_resolutions": [
    {
      "criterion_index": 0,
      "placeholders": [
        {
          "action": "ASSERT",
          "description": "store home page loaded",
          "expected_type": "url_assertion",
          "expected_locator": "expect(page).to_have_url(\"http://localhost:8781/index.html\")",
          "tolerance_selectors": ["expect(page).to_have_url", "#order-form"],
          "expected_page": "http://localhost:8781/index.html"
        }
      ]
    },
    {
      "criterion_index": 1,
      "placeholders": [
        {
          "action": "FILL",
          "description": "quantity",
          "expected_locator": "#quantity",
          "tolerance_selectors": ["input[name=\"quantity\"]"],
          "expected_page": "http://localhost:8781/index.html"
        }
      ]
    },
    {
      "criterion_index": 2,
      "placeholders": [
        {
          "action": "CLICK",
          "description": "Place Order button",
          "expected_locator": "#place-order",
          "tolerance_selectors": ["button[type=\"submit\"]"],
          "expected_page": "http://localhost:8781/success.html"
        }
      ]
    },
    {
      "criterion_index": 3,
      "placeholders": [
        {
          "action": "ASSERT",
          "description": "order success message",
          "expected_locator": "#order-success-title",
          "tolerance_selectors": ["#order-success-message", "h1"],
          "expected_page": "http://localhost:8781/success.html"
        }
      ]
    }
  ]
}
