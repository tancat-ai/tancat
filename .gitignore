# ── Evidence Sidecars ────────────────────────────────────────────────────────
evidence/
# Root-level runtime artifact (empty DB created by local runs) — not tracked.
run_results.sqlite
# The export-gate golden fixture mirrors a real generated package, whose
# run-history DB lives in evidence/ — keep that one file tracked (B-032).
!fixtures/golden_package/evidence/
!fixtures/golden_package/evidence/run_results.sqlite
# ── Generated Test Files ──────────────────────────────────────────────────────
# Ignore all generated test outputs (test packages, reports, parsed cases)
generated_tests/test_*/
generated_tests/verify_*/
# Flat generated test *scripts* (verify_production writes test_<site>.py, not a package)
# NOTE: committing these is forbidden per AGENTS.md — this rule enforces that.
generated_tests/test_*.py
# resolve-and-learn output (large — screenshots + resolved tests)
generated_tests/resolved/
generated_tests/test_cases_*.*
generated_tests/test_report_*.*
generated_tests/pages/
generated_tests/uat_*/

# But specifically DO NOT ignore these files (needed for the tool to work)
!generated_tests/conftest.py
!generated_tests/mock_insurance_site.html

