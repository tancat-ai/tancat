# tancat-ai/tancat Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env - it contains secrets!

# ===========================================
# LLM Provider Selection (Optional)
# ===========================================
# Choose one: 'ollama', 'lm-studio', 'openai-local', 'openai',
# 'azure-openai', 'openai-compatible', or 'openrouter'
# CLI and Streamlit prompt for provider settings at runtime - .env is optional.
# Platform deployments can inject the provider's own key (OPENAI_API_KEY,
# AZURE_OPENAI_API_KEY, OPENAI_COMPATIBLE_API_KEY) via app settings.
LLM_PROVIDER=ollama

# ===========================================
# Ollama Configuration (when LLM_PROVIDER=ollama)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=300

# ===========================================
# LM Studio Configuration (when LLM_PROVIDER=lm-studio)
# ===========================================
LM_STUDIO_BASE_URL=http://localhost:1234
# LM_STUDIO_MODEL is optional — when omitted, the system auto-detects the
# model currently loaded in LM Studio memory via /api/v0/models. Set this
# only if you want to force a specific model (may trigger model reload).
# LM_STUDIO_MODEL=lmstudio-community/Qwen2.5-7B-Instruct-GGUF

# ===========================================
# OpenAI Configuration (when LLM_PROVIDER=openai)
# ===========================================
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ===========================================
# Azure OpenAI (when LLM_PROVIDER=azure-openai)
# ===========================================
# Azure is NOT a plain OpenAI-compatible endpoint. The endpoint is your
# resource URL, the "model" is the DEPLOYMENT name (it goes in the request
# path), every request carries an api-version query parameter, and the key is
# sent in the api-key header (not Authorization: Bearer).
#
#   AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
#   AZURE_OPENAI_DEPLOYMENT=my-gpt4o-deployment
#   AZURE_OPENAI_API_VERSION=2024-10-21   # optional; this is the default
#
# The app builds:
#   POST {AZURE_OPENAI_ENDPOINT}/openai/deployments/{deployment}/chat/completions?api-version={version}
#   api-key: <AZURE_OPENAI_API_KEY>
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# ===========================================
# OpenAI-Compatible Cloud Providers
# (when LLM_PROVIDER=openai-compatible or openrouter)
# ===========================================
# Supports: OpenRouter, Together AI, Groq, DeepSeek, and any
# OpenAI-compatible API endpoint.
#
# For OpenRouter (https://openrouter.ai):
#   LLM_PROVIDER=openrouter
#   OPENAI_COMPATIBLE_API_KEY=sk-or-v1-...
#   OPENAI_COMPATIBLE_MODEL=openai/gpt-4o  # or anthropic/claude-sonnet-4, etc.
#
# For other providers (Together AI, Groq, DeepSeek, etc.):
#   LLM_PROVIDER=openai-compatible
#   OPENAI_COMPATIBLE_BASE_URL=https://api.together.xyz/v1
#   OPENAI_COMPATIBLE_API_KEY=your_key_here
#   OPENAI_COMPATIBLE_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#
# For AWS Bedrock, use the Bedrock Access Gateway (do NOT look for a Bedrock
# adapter): AWS ships an OpenAI-compatible gateway that fronts Bedrock models.
#   LLM_PROVIDER=openai-compatible
#   OPENAI_COMPATIBLE_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/api/v1
#   OPENAI_COMPATIBLE_API_KEY=<bedrock-gateway-api-key>
#   OPENAI_COMPATIBLE_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# The base URL shape is the API Gateway invoke URL with a trailing /api/v1
# (add the stage if you deployed one):
#   https://<api-id>.execute-api.<region>.amazonaws.com/<stage>/api/v1
# The gateway speaks /chat/completions + Authorization: Bearer, which is
# exactly what the generic compatible provider sends.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# ===========================================
# Sampling Temperature (Linear Pipeline)
# ===========================================
# Sampling temperature for LLM calls that don't set one explicitly (the
# linear pipeline path — UI/CLI/eval). Default 0.0 = deterministic, matching
# the LangGraph agents' temperature=0. Without this pin the server's own
# default (often 1.0 on llama.cpp) silently governed sampling — max entropy
# at the skeleton stage and an unrecorded confound in model A/Bs.
# Graph-path calls always send temperature=0 regardless of this setting.
AITEST_LLM_TEMPERATURE=0

# ===========================================
# Optional: Custom Timeout for Test Generation
# ===========================================
# Override provider-specific timeouts for long test generations
GENERATION_TIMEOUT=300

# ===========================================
# Streamlit Configuration (optional)
# ===========================================
# STREAMLINE_THEME=light  # or 'dark'